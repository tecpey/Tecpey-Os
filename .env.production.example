# TecPey production environment template.
# Copy to .env.production, replace every REPLACE_WITH value through the
# approved secret/configuration manager, then run:
#   bash scripts/ubuntu24-preflight.sh candidate
#
# This file contains no production credentials and must never be used unchanged.

NODE_ENV=production

NEXT_PUBLIC_SITE_URL=https://tecpey.ir
NEXT_PUBLIC_API_URL=https://my.tecpey.ir
NEXT_PUBLIC_API_BACKEND_URL=https://api.tecpey.ir
NEXT_PUBLIC_API_SOCKET_URL=wss://stream.tecpey.ir

TECPEY_SESSION_SECRET=REPLACE_WITH_DISTINCT_SESSION_SECRET_AT_LEAST_32_CHARS
TECPEY_ADMIN_SESSION_SECRET=REPLACE_WITH_DISTINCT_ADMIN_SESSION_SECRET_AT_LEAST_32_CHARS
TECPEY_REFRESH_SECRET=REPLACE_WITH_DISTINCT_REFRESH_SECRET_AT_LEAST_32_CHARS
TECPEY_ACADEMY_AUTH_SECRET=REPLACE_WITH_DISTINCT_ACADEMY_SECRET_AT_LEAST_32_CHARS
CERTIFICATE_SIGNING_SECRET=REPLACE_WITH_DISTINCT_CERTIFICATE_SECRET_AT_LEAST_32_CHARS
TECPEY_WITHDRAWAL_PRICE_SECRET=REPLACE_WITH_DISTINCT_PRICE_SECRET_AT_LEAST_32_CHARS
TECPEY_OFFLINE_SYNC_SECRET=REPLACE_WITH_DISTINCT_OFFLINE_SECRET_AT_LEAST_32_CHARS
TECPEY_CRM_PII_KEY_B64=REPLACE_WITH_BASE64_ENCODED_32_BYTE_CRM_PII_KEY
TECPEY_CRM_CONTACT_HASH_SECRET=REPLACE_WITH_DISTINCT_CRM_HASH_SECRET_AT_LEAST_32_CHARS
TECPEY_PHONE_IDENTITY_HASH_SECRET=REPLACE_WITH_DISTINCT_PHONE_HASH_SECRET_AT_LEAST_32_CHARS
TECPEY_PHONE_OTP_ENCRYPTION_KEY_B64=REPLACE_WITH_BASE64_ENCODED_32_BYTE_PHONE_OTP_KEY
TECPEY_PROVIDER_SECRET_ENCRYPTION_KEY_B64=REPLACE_WITH_BASE64_ENCODED_32_BYTE_PROVIDER_SECRET_KEY
TECPEY_2FA_SECRET=REPLACE_WITH_DISTINCT_TOTP_ENCRYPTION_SECRET_AT_LEAST_32_CHARS
TECPEY_ADMIN_TOKEN=REPLACE_WITH_ONE_TIME_ADMIN_BOOTSTRAP_TOKEN_AT_LEAST_32_CHARS

# Iran-safe authentication defaults: password + TOTP for administrators and
# Limoo mobile OTP for customers. Passkeys remain dormant unless an approved
# market rollout explicitly enables them.
TECPEY_ADMIN_PASSKEY_ENABLED=false
TECPEY_CUSTOMER_PASSKEY_ENABLED=false

# Limoo SMS is configured through the encrypted Communications control plane.
# These paired values are an optional environment fallback only; leave both
# empty when the managed provider row is authoritative.
LIMOO_SMS_API_KEY=
LIMOO_SMS_PATTERN_ID=

TECPEY_TRUSTED_PROXY_HEADER=x-forwarded-for
TECPEY_TRUSTED_PROXY_HOPS=1

DATABASE_URL=postgresql://tecpey:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/tecpey

# Managed-AI database authorities are process-scoped. The web/API process gets
# the tenant URL and signing authority only. The worker gets those plus its
# separate worker URL and process role. The migration URL belongs only in the
# migration/key-operator job; never deliver it to web or worker containers.
TECPEY_AI_TENANT_DATABASE_URL=postgresql://tecpey_ai_tenant_runtime_login:REPLACE_WITH_AI_TENANT_DATABASE_PASSWORD@postgres:5432/tecpey
TECPEY_AI_CONTEXT_HMAC_KEY_B64=REPLACE_WITH_BASE64_ENCODED_32_BYTE_AI_CONTEXT_KEY
TECPEY_AI_CONTEXT_HMAC_KEY_VERSION=REPLACE_WITH_POSITIVE_AI_CONTEXT_KEY_VERSION
TECPEY_AI_WORKER_DATABASE_URL=
TECPEY_DATABASE_PROCESS_ROLE=
TECPEY_DATABASE_MIGRATION_URL=

REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379
UPSTASH_REDIS_REST_URL=REPLACE_WITH_HTTPS_RATE_LIMIT_REDIS_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_RATE_LIMIT_REDIS_TOKEN

# Production requires an explicit live transactional-email provider before
# env:check can pass. Set EMAIL_PROVIDER to resend or sendgrid and set only the
# matching credential through the approved secret manager. dev/none/unset fail closed.
EMAIL_PROVIDER=
RESEND_API_KEY=
SENDGRID_API_KEY=

TECPEY_OPS_STATE_DIR=/var/lib/tecpey/ops
NEWS_MATERIALIZATION_LOCALES=fa,en
NEWS_MATERIALIZATION_SOURCE_MODE=live
NEWS_MATERIALIZATION_LIMIT_PER_SOURCE=100
NEWS_TRANSLATION_CONCURRENCY=2
NEWS_TRANSLATION_RETRY_MINUTES=60
NEWS_TRANSLATION_PROVIDER=openai
NEWS_TRANSLATION_MODEL=gpt-4.1-mini
NEWS_TRANSLATION_FALLBACK_MODEL=

TECPEY_REAL_WITHDRAWALS_ENABLED=0
TECPEY_CUSTODY_ENABLED_CHAINS=
TECPEY_CUSTODY_KILL_SWITCH=1
TECPEY_CUSTODY_SIMULATION_ENABLED=0

OPENAI_API_KEY=
AI_MENTOR_MODEL=gpt-4o-mini
AI_MENTOR_FALLBACK_MODEL=
PERPLEXITY_API_KEY=
XAI_API_KEY=
GROWTH_XAI_MODEL=grok-4
GROWTH_PERPLEXITY_MODEL=sonar-pro
INDEXNOW_KEY=
OPENROUTER_API_KEY=
AI_MENTOR_OPENROUTER_FALLBACK_ENABLED=false
OPENROUTER_FALLBACK_MODEL=
AI_AUTOMATION_WORKER_ENABLED=false
AI_AUTOMATION_INTERNAL_EXECUTOR_ENABLED=false
AI_AUTOMATION_POLL_MS=2000
