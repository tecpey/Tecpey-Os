+async function filterAlreadyMaterializedInputs(
+  locale: ContentLocale,
+  inputs: RawNewsInput[],
+): Promise<RawNewsInput[]> {
+  if (!inputs.length) return inputs;
+  const urls = Array.from(new Set(inputs.map((input) => input.sourceUrl).filter(Boolean)));
+  try {
+    const found = await withDb((client) => client.query<{ source_url: string }>(
+      `SELECT DISTINCT source_url FROM platform_news_impact_history_items WHERE locale = $1 AND source_url = ANY($2::text[])`,
+      [locale, urls],
+    ));
+    if (!found.enabled) return inputs;
+    const existing = new Set(found.value.rows.map((row) => row.source_url));
+    return inputs.filter((input) => !existing.has(input.sourceUrl));
+  } catch {
+    return inputs;
+  }
+}
+
+async function localizeFreshInputs(locale: ContentLocale, inputs: RawNewsInput[]): Promise<RawNewsInput[]> {
+  if (locale !== "fa") return inputs;
+  const concurrency = boundedIntegerEnv("NEWS_TRANSLATION_CONCURRENCY", 3, 1, 6);
+  const maxPerRun = boundedIntegerEnv("NEWS_TRANSLATION_MAX_PER_RUN", 60, 1, 200);
+  const selected = inputs.slice(0, maxPerRun);
+  const localized = new Array<RawNewsInput>(selected.length);
+  let cursor = 0;
+
+  const translateWorker = async (): Promise<void> => {
+    while (true) {
+      const index = cursor;
+      cursor += 1;
+      if (index >= selected.length) return;
+      const input = selected[index];
+      const translation = await translateToPersian({
+        title: input.originalTitle ?? input.title,
+        summary: input.originalSummary ?? input.summary,
+        body: input.sourceBody ?? input.summary,
+        sourceName: input.sourceName,
+      });
+      localized[index] = {
+        ...input,
+        title: translation.title,
+        summary: translation.lead,
+        translatedTitle: translation.status === "translated" ? translation.title : undefined,
+        translatedLead: translation.status === "translated" ? translation.lead : undefined,
+        translatedBody: translation.status === "translated" ? translation.body : undefined,
+        translationStatus: translation.status,
+      };
+    }
+  };
+
+  await Promise.all(Array.from({ length: Math.min(concurrency, selected.length) }, () => translateWorker()));
+  return localized;
+}
