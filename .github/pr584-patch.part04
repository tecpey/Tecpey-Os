+function categoryOf(item: NewsImpactHistoryItem, locale: "fa" | "en"): string {
+  const tags = item.topicTags ?? [];
+  const preferred = [
+    ["topic:security", locale === "fa" ? "امنیت" : "Security"],
+    ["topic:regulation", locale === "fa" ? "قوانین" : "Regulation"],
+    ["topic:etf", "ETF"],
+    ["topic:macro", locale === "fa" ? "اقتصاد کلان" : "Macro"],
+    ["topic:defi", "DeFi"],
+    ["topic:onchain", locale === "fa" ? "آنچین" : "On-chain"],
+    ["topic:derivatives", locale === "fa" ? "مشتقات" : "Derivatives"],
+    ["topic:bitcoin", "Bitcoin"],
+    ["topic:ethereum", "Ethereum"],
+  ] as const;
+  return preferred.find(([tag]) => tags.includes(tag))?.[1] ?? (locale === "fa" ? "بازار" : "Market");
+}
+
+function toNewsItem(item: NewsImpactHistoryItem, locale: "fa" | "en", now = Date.now()): NewsItem {
+  const ageHours = Math.max(0, (now - Date.parse(item.publishedAt)) / 36e5);
+  const title = locale === "fa" && item.translationStatus === "translated"
+    ? item.translatedTitle || item.title
+    : item.title;
+  const summary = locale === "fa" && item.translationStatus === "translated"
+    ? item.translatedLead || item.summary
+    : item.summary;
+  const body = locale === "fa" && item.translationStatus === "translated"
+    ? item.translatedBody || item.translatedLead || item.summary
+    : item.originalBody || item.originalSummary || item.summary;
+  return {
+    id: item.id,
+    title,
+    summary,
+    body,
+    originalTitle: item.originalTitle,
+    originalSummary: item.originalSummary,
+    originalBody: item.originalBody,
+    translationStatus: item.translationStatus ?? (locale === "fa" ? "pending" : "not_required"),
+    tags: item.topicTags ?? [],
+    source: item.sourceName,
+    url: item.sourceUrl,
+    publishedAt: item.publishedAt,
+    category: categoryOf(item, locale),
+    tone: displayTone(item),
+    impact: item.impactScore,
+    isBreaking: ageHours <= 12,
+    trendScore: Math.max(0, item.priority + Math.max(0, 24 - ageHours)),
+    editorPick: item.priority >= 85,
+    relatedLesson: item.relatedLessonHref,
+    relatedCoins: item.relatedCoinSymbols,
+    relatedTools: item.relatedToolSlugs,
+    growthAuthority: item.growthAuthority,
+  };
 }
 
