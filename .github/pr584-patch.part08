+                onClick={() => setWindow(value)}
+                className={`rounded-xl px-4 py-2 text-xs font-black transition ${window === value ? "bg-cyan-500 text-white" : "text-slate-300 hover:bg-white/5"}`}
+              >
+                {value === "24h" ? (isFa ? "۲۴ ساعت" : "24h") : value === "7d" ? (isFa ? "هفته" : "7d") : (isFa ? "ماه" : "30d")}
+              </button>
+            ))}
+          </div>
+        </div>
+
+        {items.length === 0 ? (
+          <p className="mt-6 rounded-2xl border border-white/10 bg-white/5 p-4 text-sm font-bold text-slate-300">
+            {isFa ? "برای این بازه هنوز سیگنال معتبر کافی ثبت نشده است." : "There is not enough verified signal for this window yet."}
+          </p>
+        ) : (
+          <div className="mt-6 flex snap-x gap-3 overflow-x-auto pb-2">
+            {items.map((item, index) => (
+              <Link key={item.id} href={item.href} className="group min-w-[250px] snap-start rounded-[26px] border border-white/10 bg-white/[0.055] p-4 transition hover:-translate-y-0.5 hover:border-cyan-300/35 sm:min-w-[280px]">
+                <div className="flex items-center justify-between gap-3">
+                  <span className="inline-flex h-9 min-w-9 items-center justify-center rounded-xl bg-cyan-500/10 px-2 text-xs font-black text-cyan-100">#{index + 1}</span>
+                  <ArrowUpRight className="h-4 w-4 text-cyan-300 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
+                </div>
+                <h3 className="mt-4 text-xl font-black">{item.label}</h3>
+                <p className="mt-2 text-xs font-bold leading-6 text-slate-300">{item.reason}</p>
+                <div className="mt-4 flex items-center gap-3 text-[11px] font-black text-slate-300">
+                  <span className="inline-flex items-center gap-1"><Flame className="h-3.5 w-3.5 text-orange-300" aria-hidden="true" />{isFa ? `امتیاز ${item.score}` : `Score ${item.score}`}</span>
+                  <span>{isFa ? `شتاب ${item.velocity}` : `Velocity ${item.velocity}`}</span>
+                </div>
+                <div className="mt-3 h-1.5 overflow-hidden rounded-full bg-white/10"><div className="h-full rounded-full bg-cyan-400" style={{ width: `${item.score}%` }} /></div>
+              </Link>
+            ))}
+          </div>
+        )}
+      </div>
+    </section>
+  );
+}
