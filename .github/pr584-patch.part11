+                "@type": "Answer",
+                text: isEn
+                  ? "No. TecPey presents the news as educational market context with source, timing and risk framing."
+                  : "خیر. تک‌پی این خبر را به‌عنوان زمینه آموزشی بازار همراه با منبع، زمان و چارچوب ریسک نمایش می‌دهد.",
+              },
+            },
+          ],
     },
   ];
 }
diff --git a/src/lib/news-growth-authority.ts b/src/lib/news-growth-authority.ts
new file mode 100644
index 00000000..3bf71619
--- /dev/null
+++ b/src/lib/news-growth-authority.ts
@@ -0,0 +1,256 @@
+import type { ContentLocale } from "./content-growth";
+
+export const NEWS_GROWTH_AUTHORITY_POLICY_VERSION = "tecpey-news-growth-authority-v1";
+
+export type NewsGrowthAnswer = Readonly<{
+  question: string;
+  answer: string;
+}>;
+
+export type NewsGrowthCitationFact = Readonly<{
+  label: "source" | "published_at" | "topic" | "entity";
+  value: string;
+  sourceUrl: string;
+}>;
+
+export type NewsGrowthAuthority = Readonly<{
+  policyVersion: typeof NEWS_GROWTH_AUTHORITY_POLICY_VERSION;
+  locale: ContentLocale;
+  canonicalUrl: string;
+  indexability: "index_follow" | "needs_review";
+  seo: Readonly<{
+    title: string;
+    metaDescription: string;
+    hreflang: Readonly<Partial<Record<"fa-IR" | "en-US" | "x-default", string>>>;
+    schemaTypes: readonly string[];
+    intentClusters: readonly string[];
+    longTailQueries: readonly string[];
+  }>;
+  aeo: Readonly<{
+    directAnswer: string;
+    questions: readonly NewsGrowthAnswer[];
+  }>;
+  geo: Readonly<{
+    llmSummary: string;
+    citationFacts: readonly NewsGrowthCitationFact[];
+    entityIds: readonly string[];
+    sourceAttribution: string;
+  }>;
+  topicTags: readonly string[];
+  internalLinks: readonly string[];
+  safetyDisclaimer: string;
+  freshness: Readonly<{
+    publishedAt: string;
+    recordedAt: string;
+    bucket: "breaking" | "today" | "week" | "month" | "archive";
+  }>;
+}>;
+
+export type BuildNewsGrowthAuthorityInput = {
+  locale: ContentLocale;
+  title: string;
+  summary: string;
+  canonicalUrl: string;
+  sourceName: string;
+  sourceUrl: string;
+  publishedAt: string;
+  recordedAt: string;
+  topicTags: string[];
+  detectedCoins: string[];
+  detectedTools: string[];
+  relatedLessonHref: string;
+  internalLinks: string[];
+};
+
+const HTTPS_URL_RE = /^https:\/\//i;
+const TAG_RE = /^[a-z0-9][a-z0-9:_-]{1,80}$/;
+
+function compact(value: string): string {
+  return value.replace(/\s+/g, " ").trim();
+}
+
+function truncate(value: string, maximum: number): string {
+  const normalized = compact(value);
+  if (normalized.length <= maximum) return normalized;
+  return `${normalized.slice(0, Math.max(0, maximum - 3)).trim()}...`;
+}
+
+function unique(values: string[], maximum: number): string[] {
+  return Array.from(new Set(values.map(compact).filter(Boolean))).slice(0, maximum);
+}
+
+function bucketFor(publishedAt: string, recordedAt: string): NewsGrowthAuthority["freshness"]["bucket"] {
+  const published = Date.parse(publishedAt);
+  const recorded = Date.parse(recordedAt);
+  if (!Number.isFinite(published) || !Number.isFinite(recorded)) return "archive";
+  const hours = Math.max(0, (recorded - published) / 36e5);
+  if (hours <= 6) return "breaking";
+  if (hours <= 24) return "today";
+  if (hours <= 24 * 7) return "week";
+  if (hours <= 24 * 30) return "month";
+  return "archive";
+}
+
+function absoluteInternalLink(value: string): string {
+  return value.startsWith("/") ? value : `/${value}`;
+}
+
+export function buildNewsTopicTags(
+  text: string,
+  detectedCoins: string[] = [],
+  detectedTools: string[] = [],
+): string[] {
+  const lower = text.toLowerCase();
+  const tags = new Set<string>(["topic:crypto", "content:news"]);
+  for (const coin of detectedCoins) tags.add(`coin:${coin.toLowerCase()}`);
+  for (const tool of detectedTools) tags.add(`tool:${tool.toLowerCase()}`);
+
+  const rules: Array<[string, RegExp]> = [
+    ["topic:bitcoin", /\bbitcoin\b|\bbtc\b|بیت.?کوین/i],
+    ["topic:ethereum", /\bethereum\b|\beth\b|اتریوم/i],
+    ["topic:stablecoins", /stablecoin|\busdt\b|\busdc\b|\bdai\b|تتر|استیبل/i],
+    ["topic:etf", /\betf\b|blackrock|fidelity|صندوق.*بورسی/i],
+    ["topic:regulation", /\bsec\b|regulation|regulator|law|court|ban|مقررات|قانون|دادگاه/i],
+    ["topic:macro", /\bfed\b|inflation|interest rate|cpi|jobs report|تورم|نرخ بهره|فدرال رزرو/i],
+    ["topic:security", /hack|exploit|phishing|scam|breach|security|هک|فیشینگ|کلاهبرداری|امنیت/i],
+    ["topic:exchange", /binance|coinbase|kraken|exchange|صرافی/i],
+    ["topic:defi", /\bdefi\b|dex|liquidity pool|yield|وام غیرمتمرکز|دیفای/i],
+    ["topic:layer2", /layer.?2|rollup|arbitrum|optimism|base network|لایه.?دو/i],
+    ["topic:onchain", /on.?chain|wallet flow|exchange flow|whale|آنچین|نهنگ/i],
+    ["topic:derivatives", /futures|options|open interest|funding|liquidation|فیوچرز|آپشن|فاندینگ|لیکوئید/i],
+    ["topic:liquidity", /liquidity|volume|market depth|نقدشوندگی|حجم معاملات/i],
+    ["topic:mining", /mining|miner|hashrate|ماینینگ|استخراج|هش.?ریت/i],
+    ["topic:staking", /staking|validator|استیکینگ|اعتبارسنج/i],
+    ["topic:wallets", /wallet|custody|seed phrase|کیف پول|عبارت بازیابی/i],
+    ["topic:rwa", /tokeni[sz]ation|real.?world asset|\brwa\b|توکن.*سازی|دارایی واقعی/i],
+    ["topic:institutional", /institution|institutional|treasury|نهادی|خزانه/i],
+    ["topic:ai", /artificial intelligence|\bai\b|agentic|هوش مصنوعی/i],
+    ["topic:social", /reddit|youtube|telegram|\bx\b|twitter|social|کامیونیتی|شبکه اجتماعی/i],
+  ];
+  for (const [tag, rule] of rules) if (rule.test(lower)) tags.add(tag);
+  return Array.from(tags).sort().slice(0, 36);
+}
+
+export function buildNewsGrowthAuthority(input: BuildNewsGrowthAuthorityInput): NewsGrowthAuthority {
+  const isFa = input.locale === "fa";
+  const title = compact(input.title);
+  const summary = compact(input.summary);
+  const topicTags = unique(input.topicTags, 36);
+  const entityIds = unique([
+    ...input.detectedCoins.map((symbol) => `coin:${symbol.toLowerCase()}`),
+    ...input.detectedTools.map((slug) => `tool:${slug.toLowerCase()}`),
+    ...topicTags,
+  ], 48);
+  const primaryEntities = input.detectedCoins.length
+    ? input.detectedCoins.join(", ")
+    : input.detectedTools.length
+      ? input.detectedTools.join(", ")
+      : isFa ? "بازار رمزارز" : "crypto market";
+  const directAnswer = isFa
+    ? `${title}. این خبر درباره ${primaryEntities} است و برای درک اثر آن باید منبع اصلی، زمان انتشار و داده‌های بازار را کنار هم بررسی کرد.`
+    : `${title}. This story concerns ${primaryEntities}; its impact should be evaluated alongside the original source, publication time and current market data.`;
+  const sourceAttribution = `${input.sourceName} · ${input.sourceUrl}`;
+  const safetyDisclaimer = isFa
+    ? "این صفحه زمینه خبری و آموزشی است و توصیه مالی، سیگنال خرید یا فروش یا وعده سود نیست."
+    : "This page provides news and educational context, not financial advice, a buy/sell signal or a profit promise.";
+
+  return {
+    policyVersion: NEWS_GROWTH_AUTHORITY_POLICY_VERSION,
+    locale: input.locale,
+    canonicalUrl: input.canonicalUrl,
+    indexability: "index_follow",
+    seo: {
+      title: truncate(isFa ? `${title} | اخبار رمزارز تک‌پی` : `${title} | TecPey Crypto News`, 92),
+      metaDescription: truncate(summary, 168),
+      hreflang: input.locale === "fa"
+        ? { "fa-IR": input.canonicalUrl, "x-default": input.canonicalUrl }
+        : { "en-US": input.canonicalUrl, "x-default": input.canonicalUrl },
+      schemaTypes: ["NewsArticle", "BreadcrumbList", "ItemList"],
+      intentClusters: unique([
+        ...(isFa ? ["خبر امروز رمزارز", "اخبار بازار کریپتو", "چرا این خبر مهم است"] : ["crypto news today", "crypto market news", "why this crypto news matters"]),
+        ...input.detectedCoins.map((symbol) => `${symbol} news`),
+        ...input.detectedTools.map((slug) => `${slug} crypto tool`),
+      ], 18),
+      longTailQueries: unique([
+        title,
+        isFa ? `اخبار ${primaryEntities} امروز` : `${primaryEntities} news today`,
+        isFa ? `چرا خبر ${primaryEntities} مهم است` : `why ${primaryEntities} news matters`,
+        ...topicTags.filter((tag) => tag.startsWith("topic:") && tag !== "topic:crypto").map((tag) =>
+          isFa ? `اخبار ${tag.replace("topic:", "").replace(/-/g, " ")}` : `${tag.replace("topic:", "").replace(/-/g, " ")} crypto news`,
+        ),
+        ...(isFa
+          ? input.detectedCoins.flatMap((symbol) => [`خبر ${symbol} امروز`, `اثر خبر بر ${symbol}`])
+          : input.detectedCoins.flatMap((symbol) => [`${symbol} news today`, `impact on ${symbol}`])),
+        ...(isFa
+          ? input.detectedTools.map((slug) => `${slug} برای تحلیل این خبر`)
+          : input.detectedTools.map((slug) => `${slug} for this news analysis`)),
+      ], 24),
+    },
+    aeo: {
+      directAnswer: truncate(directAnswer, 420),
+      questions: [
+        {
+          question: isFa ? "چه اتفاقی افتاده است؟" : "What happened?",
+          answer: truncate(summary || title, 360),
+        },
+        {
+          question: isFa ? "چرا این خبر مهم است؟" : "Why does this matter?",
+          answer: truncate(isFa
+            ? `این خبر به ${primaryEntities} مرتبط است و می‌تواند بر توجه بازار، نقدشوندگی یا ارزیابی ریسک اثر بگذارد.`
+            : `The story is related to ${primaryEntities} and may affect market attention, liquidity or risk assessment.`, 360),
+        },
+        {
+          question: isFa ? "برای بررسی بیشتر چه چیزی را ببینم؟" : "What should I review next?",
+          answer: truncate(isFa
+            ? `منبع اصلی ${input.sourceName}، داده‌های مارکت‌برد تک‌پی و مسیر آموزشی مرتبط را بررسی کنید.`
+            : `Review the original ${input.sourceName} source, TecPey market data and the related learning path.`, 360),
+        },
+      ],
+    },
+    geo: {
+      llmSummary: truncate(`${title}. ${summary} Source: ${input.sourceName}. Published: ${input.publishedAt}. ${safetyDisclaimer}`, 900),
+      citationFacts: [
+        { label: "source", value: input.sourceName, sourceUrl: input.sourceUrl },
+        { label: "published_at", value: input.publishedAt, sourceUrl: input.sourceUrl },
+        { label: "topic", value: topicTags.join(", ") || "crypto-news", sourceUrl: input.sourceUrl },
+        ...input.detectedCoins.slice(0, 5).map((symbol) => ({ label: "entity" as const, value: symbol, sourceUrl: input.sourceUrl })),
+      ],
+      entityIds,
+      sourceAttribution,
+    },
+    topicTags,
+    internalLinks: unique([
+      ...input.internalLinks.map(absoluteInternalLink),
+      input.relatedLessonHref,
+      isFa ? "/crypto-news" : "/en/crypto-news",
+      isFa ? "/markets" : "/en/markets",
+      isFa ? "/coins" : "/en/coins",
+      isFa ? "/trading-tools" : "/en/trading-tools",
+    ], 24),
+    safetyDisclaimer,
+    freshness: {
+      publishedAt: input.publishedAt,
+      recordedAt: input.recordedAt,
+      bucket: bucketFor(input.publishedAt, input.recordedAt),
+    },
+  };
+}
+
+export function validateNewsGrowthAuthority(value: unknown): value is NewsGrowthAuthority {
+  if (!value || typeof value !== "object") return false;
+  const authority = value as NewsGrowthAuthority;
+  if (authority.policyVersion !== NEWS_GROWTH_AUTHORITY_POLICY_VERSION) return false;
+  if (authority.locale !== "fa" && authority.locale !== "en") return false;
+  if (!HTTPS_URL_RE.test(authority.canonicalUrl)) return false;
+  if (authority.indexability !== "index_follow") return false;
+  if (!authority.seo?.schemaTypes?.includes("NewsArticle") || !authority.seo.schemaTypes.includes("BreadcrumbList")) return false;
+  const localeHref = authority.seo.hreflang[authority.locale === "fa" ? "fa-IR" : "en-US"];
+  if (localeHref !== authority.canonicalUrl || authority.seo.hreflang["x-default"] !== authority.canonicalUrl) return false;
+  if (authority.seo.intentClusters.length < 3 || authority.seo.longTailQueries.length < 3) return false;
+  if (authority.aeo.directAnswer.length < 60 || authority.aeo.questions.length < 3) return false;
+  if (authority.geo.llmSummary.length < 100 || authority.geo.citationFacts.length < 3) return false;
+  if (authority.topicTags.length < 2 || !authority.topicTags.every((tag) => TAG_RE.test(tag))) return false;
+  if (authority.internalLinks.length < 4 || !authority.internalLinks.every((href) => href.startsWith("/"))) return false;
+  if (!/(توصیه مالی|سیگنال|financial advice|buy\/sell signal)/i.test(authority.safetyDisclaimer)) return false;
+  return Number.isFinite(Date.parse(authority.freshness.publishedAt)) && Number.isFinite(Date.parse(authority.freshness.recordedAt));
+}
diff --git a/src/lib/news-impact-history-authority.ts b/src/lib/news-impact-history-authority.ts
index 8b906048..47ea0a6e 100644
--- a/src/lib/news-impact-history-authority.ts
+++ b/src/lib/news-impact-history-authority.ts
@@ -17,6 +17,15 @@ type NewsImpactHistoryRow = {
   news_url: string;
   title: string;
   summary: string;
+  original_title?: string | null;
+  original_summary?: string | null;
