+  translated_lead?: string | null;
+  translated_body?: string | null;
+  translation_status?: "not_required" | "translated" | "pending" | "failed" | null;
+  topic_tags?: string[] | null;
+  growth_authority?: unknown;
   source_name: string;
   source_url: string;
   published_at: Date | string;
@@ -69,6 +78,15 @@ export function mapNewsImpactHistoryRow(row: NewsImpactHistoryRow): NewsImpactHi