+export function validateNewsArchiveDate(value: string): string {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) throw new Error("news_archive_date_invalid");
+  const [year, month, day] = value.split("-").map(Number);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new Error("news_archive_date_invalid");
+  }
+  return value;
+}
+
+export function tehranNewsDate(now = new Date()): string {
+  const parts = new Intl.DateTimeFormat("en-CA", {
+    timeZone: "Asia/Tehran",
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(now);
+  const value = Object.fromEntries(parts.map((part) => [part.type, part.value]));
+  return `${value.year}-${value.month}-${value.day}`;
+}
+
+export async function readNewsArchiveDayTx(
+  client: PoolClient,
+  locale: ContentLocale,
+  date: string,
+): Promise<NewsImpactHistoryItem[]> {
+  const selectedDate = validateNewsArchiveDate(date);
+  const result = await client.query<NewsImpactHistoryRow>(
+    `SELECT history_id, locale, slug, news_url, title, summary, original_title, original_summary, original_body,
+            translated_title, translated_lead, translated_body, translation_status, topic_tags, growth_authority,
+            source_name, source_url, published_at, recorded_at, priority, impact_score, tone, reason_fa, reason_en,
+            related_tool_slugs, related_coin_symbols, related_lesson_href
+       FROM platform_news_impact_history_items
+      WHERE locale = $1
+        AND (published_at AT TIME ZONE 'Asia/Tehran')::date = $2::date
+      ORDER BY published_at DESC, priority DESC, history_id ASC`,
+    [locale, selectedDate],
+  );
+  return result.rows.map(mapNewsImpactHistoryRow);
+}
+
+export async function readNewsArchiveDatesTx(
+  client: PoolClient,
+  locale: ContentLocale,
+): Promise<string[]> {
+  const result = await client.query<{ news_date: string }>(
+    `SELECT DISTINCT to_char((published_at AT TIME ZONE 'Asia/Tehran')::date, 'YYYY-MM-DD') AS news_date
+       FROM platform_news_impact_history_items
+      WHERE locale = $1
+      ORDER BY news_date DESC
+      LIMIT 366`,
+    [locale],
+  );
+  return result.rows.map((row) => row.news_date);
+}
+
+export async function getNewsArchiveDayFromAuthority(
+  locale: ContentLocale,
+  date = tehranNewsDate(),
+): Promise<{ items: NewsImpactHistoryItem[]; dates: string[]; date: string; sourceAuthority: "postgres" | "seed_fallback" }> {
+  const selectedDate = validateNewsArchiveDate(date);
+  try {
+    const result = await withDb(async (client) => {
+      const items = await readNewsArchiveDayTx(client, locale, selectedDate);
+      const dates = await readNewsArchiveDatesTx(client, locale);
+      return { items, dates };
+    });
+    if (result.enabled) return { ...result.value, date: selectedDate, sourceAuthority: "postgres" };
+  } catch (error) {
+    logger.warn("[news-impact-history] archive authority read failed", {
+      locale,
+      date: selectedDate,
+      error: error instanceof Error ? error.message : String(error),
+    });
+  }
+  const seedItems = getNewsImpactHistoryItems(locale);
+  const seeded = seedItems.filter((item) => tehranNewsDate(new Date(item.publishedAt)) === selectedDate);
+  const dates = Array.from(
+    new Set(seedItems.map((item) => tehranNewsDate(new Date(item.publishedAt)))),
+  ).sort((left, right) => right.localeCompare(left));
+  return { items: seeded.sort(sortNewsImpactHistoryItems), dates, date: selectedDate, sourceAuthority: "seed_fallback" };
+}
+
+export async function getNewsImpactHistoryArchiveFromAuthority(
+  locale?: ContentLocale,
+): Promise<NewsImpactHistoryItem[]> {
+  try {
+    const result = await withDb((client) => {
+      const params = locale ? [locale] : [];
+      const where = locale ? "WHERE locale = $1" : "";
+      return client.query<NewsImpactHistoryRow>(
+        `SELECT history_id, locale, slug, news_url, title, summary, original_title, original_summary, original_body,
+                translated_title, translated_lead, translated_body, translation_status, topic_tags, growth_authority,
+                source_name, source_url, published_at, recorded_at, priority, impact_score, tone, reason_fa, reason_en,
+                related_tool_slugs, related_coin_symbols, related_lesson_href
+           FROM platform_news_impact_history_items
+           ${where}
+          ORDER BY published_at DESC, priority DESC, history_id ASC
+          LIMIT 5000`,
+        params,
+      );
+    });
+    if (result.enabled) return result.value.rows.map(mapNewsImpactHistoryRow);
+  } catch (error) {
+    logger.warn("[news-impact-history] archive sitemap read failed", {
+      locale: locale ?? "all",
+      error: error instanceof Error ? error.message : String(error),
+    });
+  }
+  return getNewsImpactHistoryItems(locale).sort(sortNewsImpactHistoryItems);
+}
+
 export function mergeNewsImpactHistoryItems(
   persisted: NewsImpactHistoryItem[],
   seeded: NewsImpactHistoryItem[],
