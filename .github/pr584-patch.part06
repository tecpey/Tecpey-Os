diff --git a/src/components/content/CryptoNewsArchiveCenter.tsx b/src/components/content/CryptoNewsArchiveCenter.tsx
new file mode 100644
index 00000000..d11e2bda
--- /dev/null
+++ b/src/components/content/CryptoNewsArchiveCenter.tsx
@@ -0,0 +1,245 @@
+"use client";
+
+import { useEffect, useMemo, useState } from "react";
+import { CalendarDays, ChevronDown, ExternalLink, Search, Tag } from "lucide-react";
+
+type Locale = "fa" | "en";
+type NewsItem = {
+  id: string;
+  title: string;
+  summary: string;
+  body: string;
+  originalTitle?: string;
+  originalSummary?: string;
+  originalBody?: string;
+  translationStatus: "not_required" | "translated" | "pending" | "failed";
+  tags: string[];
+  source: string;
+  url: string;
+  publishedAt: string;
+  category: string;
+  impact: number;
+  relatedCoins: string[];
+  relatedTools: string[];
+};
+
+type ArchiveResponse = {
+  date: string;
+  availableDates: string[];
+  items: NewsItem[];
+  total: number;
+  sourceAuthority: "postgres" | "seed_fallback";
+};
+
+function localeDate(value: string, locale: Locale): string {
+  const parsed = new Date(`${value}T12:00:00Z`);
+  return new Intl.DateTimeFormat(locale === "fa" ? "fa-IR" : "en-US", {
+    year: "numeric",
+    month: "long",
+    day: "numeric",
+    timeZone: "Asia/Tehran",
+  }).format(parsed);
+}
+
+function tagLabel(tag: string, locale: Locale): string {
+  const cleaned = tag.replace(/^(topic|coin|tool|content):/, "").replace(/-/g, " ");
+  const fa: Record<string, string> = {
+    crypto: "کریپتو",
+    bitcoin: "بیت‌کوین",
+    ethereum: "اتریوم",
+    stablecoins: "استیبل‌کوین",
+    regulation: "قوانین",
+    security: "امنیت",
+    macro: "اقتصاد کلان",
+    onchain: "آنچین",
+    derivatives: "مشتقات",
