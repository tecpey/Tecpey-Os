diff --git a/src/lib/db-migrate-news-growth-archive.ts b/src/lib/db-migrate-news-growth-archive.ts
new file mode 100644
index 00000000..d669d6d9
--- /dev/null
+++ b/src/lib/db-migrate-news-growth-archive.ts
@@ -0,0 +1,66 @@
+import { createHash } from "node:crypto";
+import type { PoolClient } from "pg";
+
+const FILENAME = "0098_news_growth_archive.sql";
+
+export const NEWS_GROWTH_ARCHIVE_SQL = `
+ALTER TABLE platform_news_impact_history_items
+  ADD COLUMN IF NOT EXISTS original_title TEXT,
+  ADD COLUMN IF NOT EXISTS original_summary TEXT,
+  ADD COLUMN IF NOT EXISTS original_body TEXT,
+  ADD COLUMN IF NOT EXISTS translated_title TEXT,
+  ADD COLUMN IF NOT EXISTS translated_lead TEXT,
+  ADD COLUMN IF NOT EXISTS translated_body TEXT,
+  ADD COLUMN IF NOT EXISTS translation_status TEXT
+    CHECK (translation_status IS NULL OR translation_status IN ('not_required', 'translated', 'pending', 'failed')),
+  ADD COLUMN IF NOT EXISTS topic_tags TEXT[] NOT NULL DEFAULT '{}',
+  ADD COLUMN IF NOT EXISTS growth_authority JSONB,
+  ADD COLUMN IF NOT EXISTS content_fingerprint CHAR(64);
+
+CREATE INDEX IF NOT EXISTS platform_news_impact_history_day_idx
+  ON platform_news_impact_history_items (locale, published_at DESC);
+CREATE INDEX IF NOT EXISTS platform_news_impact_history_topic_tags_idx
+  ON platform_news_impact_history_items USING GIN (topic_tags);
+
+ALTER TABLE platform_news_impact_history_items
+  DROP CONSTRAINT IF EXISTS platform_news_impact_history_growth_authority_check;
+ALTER TABLE platform_news_impact_history_items
+  ADD CONSTRAINT platform_news_impact_history_growth_authority_check
+  CHECK (growth_authority IS NULL OR jsonb_typeof(growth_authority) = 'object');
+
+ALTER TABLE platform_news_impact_history_items
+  DROP CONSTRAINT IF EXISTS platform_news_impact_history_fingerprint_check;
+ALTER TABLE platform_news_impact_history_items
+  ADD CONSTRAINT platform_news_impact_history_fingerprint_check
+  CHECK (content_fingerprint IS NULL OR content_fingerprint ~ '^[0-9a-f]{64}$');
+`;
+
+function checksum(sql: string): string {
+  return createHash("sha256")
+    .update(sql.replace(/\r\n?/g, "\n").trim())
+    .digest("hex");
+}
+
+export async function runNewsGrowthArchiveMigrations(client: PoolClient): Promise<void> {
+  const cs = checksum(NEWS_GROWTH_ARCHIVE_SQL);
+  const applied = await client.query<{ checksum: string }>(
+    "SELECT checksum FROM _migrations WHERE filename = $1 LIMIT 1",
+    [FILENAME],
+  );
+  if (applied.rows[0]) {
+    if (applied.rows[0].checksum !== cs) {
+      throw new Error(`[db-migrate-news-growth-archive] checksum mismatch for ${FILENAME}`);
+    }
+    return;
+  }
+
+  await client.query("BEGIN");
+  try {
+    await client.query(NEWS_GROWTH_ARCHIVE_SQL);
+    await client.query("INSERT INTO _migrations (filename, checksum) VALUES ($1, $2)", [FILENAME, cs]);
+    await client.query("COMMIT");
+  } catch (error) {
+    await client.query("ROLLBACK");
+    throw error;
+  }
+}
