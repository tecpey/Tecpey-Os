diff --git a/src/lib/growth-trend-intelligence.ts b/src/lib/growth-trend-intelligence.ts
new file mode 100644
index 00000000..41b1c8cb
--- /dev/null
+++ b/src/lib/growth-trend-intelligence.ts
@@ -0,0 +1,181 @@
+import { coinPages } from "@/data/coins";
+import type { ContentLocale } from "./content-growth";
+import { getNewsImpactDetailPath, type NewsImpactHistoryItem } from "./news-impact-history";
+import { getNewsImpactHistoryArchiveFromAuthority } from "./news-impact-history-authority";
+
+export type GrowthTrendWindow = "24h" | "7d" | "30d";
+export type GrowthTrendEntityType = "coin" | "tool" | "topic";
+
+export type GrowthTrendItem = Readonly<{
+  id: string;
+  entityType: GrowthTrendEntityType;
+  label: string;
+  score: number;
+  velocity: number;
+  newsCount: number;
+  sourceCount: number;
+  socialSignalCount: number;
+  latestPublishedAt: string;
+  href: string;
+  reason: string;
+  relatedNews: string[];
+}>;
+
+export type GrowthTrendModel = Readonly<Record<GrowthTrendWindow, readonly GrowthTrendItem[]>>;
+
+const WINDOW_MS: Record<GrowthTrendWindow, number> = {
+  "24h": 24 * 60 * 60 * 1_000,
+  "7d": 7 * 24 * 60 * 60 * 1_000,
+  "30d": 30 * 24 * 60 * 60 * 1_000,
+};
+
+function sourceIsSocial(url: string): boolean {
+  try {
+    const host = new URL(url).hostname.replace(/^www\./, "").toLowerCase();
+    return ["x.com", "twitter.com", "reddit.com", "youtube.com", "youtu.be", "t.me", "telegram.me"].some((domain) => host === domain || host.endsWith(`.${domain}`));
+  } catch {
+    return false;
+  }
+}
+
+function topicLabel(tag: string, locale: ContentLocale): string {
+  const key = tag.replace(/^topic:/, "").replace(/-/g, " ");
+  const fa: Record<string, string> = {
+    crypto: "بازار کریپتو",
+    bitcoin: "بیت‌کوین",
+    ethereum: "اتریوم",
+    stablecoins: "استیبل‌کوین‌ها",
+    etf: "ETF رمزارز",
+    regulation: "قوانین و مقررات",
+    macro: "اقتصاد کلان",
+    security: "امنیت",
+    exchange: "صرافی‌ها",
+    defi: "DeFi",
+    layer2: "لایه دوم",
+    onchain: "داده آنچین",
+    derivatives: "مشتقات",
+    liquidity: "نقدشوندگی",
+    mining: "استخراج",
+    staking: "استیکینگ",
+    wallets: "کیف پول",
+    rwa: "RWA و توکن‌سازی",
+    institutional: "سرمایه نهادی",
+    ai: "هوش مصنوعی و کریپتو",
+    social: "کامیونیتی و سوشال",
+  };
+  return locale === "fa" ? fa[key] ?? key : key.replace(/\b\w/g, (char) => char.toUpperCase());
+}
+
+function coinHref(symbol: string, locale: ContentLocale): string {
+  const coin = coinPages.find((item) => item.symbol.toUpperCase() === symbol.toUpperCase());
+  const slug = coin?.slug ?? symbol.toLowerCase();
+  return `${locale === "en" ? "/en" : ""}/coins/${slug}`;
+}
+
+function entitySignals(item: NewsImpactHistoryItem, locale: ContentLocale): Array<{ type: GrowthTrendEntityType; id: string; label: string; href: string }> {
+  const coins = item.relatedCoinSymbols.map((symbol) => ({
+    type: "coin" as const,
+    id: symbol.toUpperCase(),
+    label: symbol.toUpperCase(),
+    href: coinHref(symbol, locale),
+  }));
+  const tools = item.relatedToolSlugs.map((slug) => ({
+    type: "tool" as const,
+    id: slug,
+    label: slug.split("-").map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(" "),
+    href: `${locale === "en" ? "/en" : ""}/trading-tools/${slug}`,
+  }));
+  const topics = (item.topicTags ?? [])
+    .filter((tag) => tag.startsWith("topic:") && tag !== "topic:crypto")
+    .map((tag) => ({
+      type: "topic" as const,
+      id: tag,
+      label: topicLabel(tag, locale),
+      href: `${locale === "en" ? "/en" : ""}/crypto-news`,
+    }));
+  return [...coins, ...tools, ...topics];
+}
+
+function rankWindow(items: NewsImpactHistoryItem[], locale: ContentLocale, window: GrowthTrendWindow, now: number): GrowthTrendItem[] {
+  const cutoff = now - WINDOW_MS[window];
+  const byEntity = new Map<string, {
+    entityType: GrowthTrendEntityType;
+    id: string;
+    label: string;
+    href: string;
+    weighted: number;
+    newsCount: number;
+    sources: Set<string>;
+    social: number;
+    latest: number;
+    relatedNews: string[];
+  }>();
+
+  for (const item of items) {
+    const published = Date.parse(item.publishedAt);
+    if (!Number.isFinite(published) || published < cutoff || published > now + 10 * 60 * 1_000) continue;
+    const ageRatio = Math.max(0, Math.min(1, (now - published) / WINDOW_MS[window]));
+    const recency = 1 - ageRatio * 0.72;
+    const base = (item.priority / 100) * 0.48 + (item.impactScore / 10) * 0.32 + recency * 0.2;
+    for (const entity of entitySignals(item, locale)) {
+      const key = `${entity.type}:${entity.id}`;
+      const current = byEntity.get(key) ?? {
+        entityType: entity.type,
+        id: entity.id,
+        label: entity.label,
+        href: entity.href,
+        weighted: 0,
+        newsCount: 0,
+        sources: new Set<string>(),
+        social: 0,
+        latest: 0,
+        relatedNews: [],
+      };
+      current.weighted += base;
+      current.newsCount += 1;
+      current.sources.add(item.sourceName);
+      if (sourceIsSocial(item.sourceUrl)) current.social += 1;
+      current.latest = Math.max(current.latest, published);
+      if (current.relatedNews.length < 3) current.relatedNews.push(getNewsImpactDetailPath(item));
+      byEntity.set(key, current);
+    }
+  }
+
+  const maxWeighted = Math.max(1, ...Array.from(byEntity.values()).map((value) => value.weighted));
+  return Array.from(byEntity.values())
+    .map((value) => {
+      const diversity = Math.min(1, value.sources.size / 4);
+      const socialBoost = Math.min(1, value.social / 3);
+      const normalized = value.weighted / maxWeighted;
+      const score = Math.round(Math.min(100, (normalized * 0.7 + diversity * 0.2 + socialBoost * 0.1) * 100));
+      const velocity = Math.round(Math.min(100, ((value.newsCount / Math.max(1, window === "24h" ? 3 : window === "7d" ? 7 : 14)) * 0.7 + diversity * 0.3) * 100));
+      const reason = locale === "fa"
+        ? `${value.newsCount} خبر از ${value.sources.size} منبع${value.social ? ` و ${value.social} سیگنال اجتماعی` : ""}`
+        : `${value.newsCount} stories across ${value.sources.size} sources${value.social ? ` plus ${value.social} social signals` : ""}`;
+      return {
+        id: `${value.entityType}:${value.id}`,
+        entityType: value.entityType,
+        label: value.label,
+        score,
+        velocity,
+        newsCount: value.newsCount,
+        sourceCount: value.sources.size,
+        socialSignalCount: value.social,
+        latestPublishedAt: new Date(value.latest).toISOString(),
+        href: value.href,
+        reason,
+        relatedNews: value.relatedNews,
+      } satisfies GrowthTrendItem;
+    })
+    .sort((a, b) => b.score - a.score || b.velocity - a.velocity || a.label.localeCompare(b.label))
+    .slice(0, 12);
+}
+
+export async function getGrowthTrendModel(locale: ContentLocale, now = Date.now()): Promise<GrowthTrendModel> {
+  const items = await getNewsImpactHistoryArchiveFromAuthority(locale);
+  return {
+    "24h": rankWindow(items, locale, "24h", now),
+    "7d": rankWindow(items, locale, "7d", now),
+    "30d": rankWindow(items, locale, "30d", now),
+  };
+}
