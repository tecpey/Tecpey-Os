-      const updatedAt = new Date().toISOString();
-      const settled = await Promise.allSettled(sourceList.map((source) => readSource(source, locale)));
-      const items = settled.flatMap((result) => result.status === "fulfilled" ? result.value : []);
-      const unique = Array.from(new Map(items.map((item) => [item.title.toLowerCase(), item])).values())
-        .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
-        .slice(0, limit);
-      const responseItems = unique;
-      return apiOk({
-        locale,
-        updatedAt,
-        mode: unique.length ? "live" : "fallback" as const,
-        marketIntelligence: marketIntelligence(locale, responseItems),
-        items: responseItems,
-        ...quizFor(unique),
-        ...automationPayloadFor(unique, updatedAt),
-      });
+      selectedDate = validateNewsArchiveDate(selectedDate);
     } catch {
-      const updatedAt = new Date().toISOString();
-      return apiOk({
-        locale,
-        updatedAt,
-        mode: "fallback" as const,
-        marketIntelligence: marketIntelligence(locale, []),
-        items: [],
-        ...quizFor([]),
-        ...automationPayloadFor([], updatedAt),
-      });
+      return apiError("news_archive_date_invalid", 400);
     }
+    if (selectedDate > today) return apiError("news_archive_date_future", 400);
+
+    const archive = await getNewsArchiveDayFromAuthority(locale, selectedDate);
+    const allItems = archive.items.map((item) => toNewsItem(item, locale));
+    const showAll = request.nextUrl.searchParams.get("all") === "1";
+    const items = showAll ? allItems : allItems.slice(0, boundedLimit(request.nextUrl.searchParams.get("limit")));
+    const updatedAt = allItems[0]?.publishedAt ?? new Date().toISOString();
+    const includeQuiz = request.nextUrl.searchParams.get("quiz") === "1";
+    const includeAutomation = request.nextUrl.searchParams.get("automation") === "1";
+    const automationInputs = allItems.map((item) => toAutomationInput(item, locale, updatedAt));
+    const decisions = includeQuiz || includeAutomation ? buildNewsAutomationBatch(automationInputs) : [];
+    const automation = includeAutomation
+      ? materializeNewsAutomationDecisions(decisions, { locale, generatedAt: updatedAt, historyLimit: Math.max(24, allItems.length), topCoinLimit: 8 })
+      : undefined;
+
+    return apiOk({
+      locale,
+      date: archive.date,
+      availableDates: archive.dates,
+      sourceAuthority: archive.sourceAuthority,
+      updatedAt,
+      mode: allItems.length ? "live" : "fallback",
+      marketIntelligence: marketIntelligence(locale, allItems),
+      items,
+      total: allItems.length,
+      ...(includeQuiz ? { newsQuiz: buildNewsQuizBankFromFeed(allItems, { locale }) } : {}),
+      ...(automation ? { automation } : {}),
+    });
   });
 }
