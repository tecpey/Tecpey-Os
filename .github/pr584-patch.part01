+import fs from "node:fs";
+import path from "node:path";
+import process from "node:process";
+
+const ROOT = process.cwd();
+const read = (p) => fs.readFileSync(path.join(ROOT, p), "utf8");
+const fail = (errors, label, condition) => { if (!condition) errors.push(label); };
+
+export function evaluateMarketNewsGrowthEnterprise() {
+  const errors = [];
+  const market = read("src/app/markets/page.tsx");
+  const table = read("src/components/markets/MarketsTable.tsx");
+  const motion = read("src/components/brand/tecpey-scroll-motion-routes.ts");
+  const coinVisuals = read("src/lib/coin-visual-assets.ts");
+  const footer = read("src/components/footer/Footer.tsx");
+  const newsApi = read("src/app/api/crypto-news/route.ts");
+  const worker = read("scripts/run-news-materialization-worker.ts");
+  const timer = read("deploy/systemd/tecpey-news-materialization.timer");
+  const growth = read("src/lib/news-growth-authority.ts");
+  const trends = read("src/lib/growth-trend-intelligence.ts");
+  const trendWidget = read("src/components/content/GrowthTrendWidget.tsx");
+  const archive = read("src/components/content/CryptoNewsArchiveCenter.tsx");
+  const intelligence = read("src/lib/news-intelligence-graph.ts");
+  const materialization = read("src/lib/news-materialization.ts");
+  const migration = read("src/lib/db-migrate-news-growth-archive.ts");
+  const registry = read("src/lib/db-migration-registry.ts");
