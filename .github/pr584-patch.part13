+// archive day and prove the UI/quiz path never needs an external feed request.
 
 const realFetch = globalThis.fetch;
-const TEST_NOW = Date.parse("2030-03-15T12:00:00.000Z");
-const LIVE_PUBLISHED_AT = new Date(TEST_NOW - 60 * 60 * 1000).toUTCString();
+const TEST_NOW = Date.parse("2026-08-09T12:00:00.000Z");
 
