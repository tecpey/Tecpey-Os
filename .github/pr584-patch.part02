+  const newsFa = read("src/app/crypto-news/page.tsx");
+  const newsEn = read("src/app/en/crypto-news/page.tsx");
+  const newsDetailFa = read("src/app/crypto-news/[slug]/page.tsx");
+  const newsDetailEn = read("src/app/en/crypto-news/[slug]/page.tsx");
+  const aiAutomationStore = read("src/lib/ai/automation-store.ts");
+  const stagingNewsAuthority = read("scripts/check-news-materialization-staging-evidence-authority.mjs");
+  const coinsFa = read("src/app/coins/page.tsx");
+  const coinsEn = read("src/app/en/coins/page.tsx");
+  const toolsFa = read("src/app/trading-tools/page.tsx");
+  const toolsEn = read("src/app/en/trading-tools/page.tsx");
+
+  fail(errors, "market board must request 30 rows per page", /const LIMIT = 30;/.test(market));
+  fail(errors, "market search must render before MarketsHero", market.indexOf("<MarketsSearchBar") < market.indexOf("<MarketsHero"));
+  fail(errors, "market board must expose a 1480px enterprise width", market.includes("max-w-[1480px]") && table.includes("max-w-[1480px]"));
+  fail(errors, "market table must keep a bounded horizontal mobile fallback", table.includes("overflow-x-auto") && table.includes("min-w-[860px]"));
+
+  for (const route of ["/markets", "/en/markets", "/crypto-news", "/en/crypto-news", "/coins", "/en/coins", "/trading-tools", "/en/trading-tools"]) {
+    fail(errors, `scroll motion allowlist missing ${route}`, motion.includes(`"${route}"`));
+  }
+  fail(errors, "unknown coin fallback must not silently become Bitcoin", coinVisuals.includes('sourceLabel: "TecPey generated vector fallback"') && !/return fallbackCoinVisual;\s*\n}/.test(coinVisuals));
+
+  fail(errors, "footer must be one horizontally scrollable/snap container on mobile", footer.includes("snap-x snap-mandatory") && footer.includes("overflow-x-auto"));
+  fail(errors, "footer must keep four Persian and four English groups", (footer.match(/title: "/g) ?? []).length >= 8);
+  fail(errors, "footer must expose current-page semantics", footer.includes('aria-current={active ? "page" : undefined}'));
+
+  fail(errors, "news API must read the archive authority", newsApi.includes("getNewsArchiveDayFromAuthority"));
+  fail(errors, "news API must not perform external feed ingestion on page reads", !newsApi.includes("coindesk.com") && !newsApi.includes("cointelegraph.com/rss") && !newsApi.includes("readBoundedResponseText"));
+  fail(errors, "news API must support all records for a selected day", newsApi.includes('searchParams.get("all") === "1"'));
+  fail(errors, "news archive UI must support date, search and tag filters", archive.includes('type="date"') && archive.includes("activeTags") && archive.includes("Search"));
+
+  fail(errors, "news worker must use governed AI translation", worker.includes("callAiProvider") && worker.includes("translateToPersian"));
+  fail(errors, "news worker must translate only fresh, not-yet-materialized stories", worker.includes("filterAlreadyMaterializedInputs") && worker.includes("localizeFreshInputs"));
+  fail(errors, "news worker must preserve numeric claims", worker.includes("numbersIn") && worker.includes("numericMismatch"));
+  fail(errors, "news translation must use bounded concurrency and per-run budget", worker.includes("NEWS_TRANSLATION_CONCURRENCY") && worker.includes("NEWS_TRANSLATION_MAX_PER_RUN") && worker.includes("Promise.all"));
+  fail(errors, "scheduler must start after boot", timer.includes("OnBootSec=2min"));
+  fail(errors, "scheduler must run continuously every 10 minutes", timer.includes("OnUnitActiveSec=10min") && timer.includes("Persistent=true"));
+  fail(errors, "staging authority must verify the same ten-minute scheduler contract", stagingNewsAuthority.includes("OnUnitActiveSec=10min"));
+
+  fail(errors, "news growth authority must explicitly model SEO", growth.includes("seo: Readonly") && growth.includes("hreflang") && growth.includes("schemaTypes"));
+  fail(errors, "news growth authority must explicitly model AEO", growth.includes("aeo: Readonly") && growth.includes("directAnswer") && growth.includes("questions"));
+  fail(errors, "news growth authority must explicitly model GEO", growth.includes("geo: Readonly") && growth.includes("llmSummary") && growth.includes("citationFacts"));
+  for (const tag of ["topic:regulation", "topic:macro", "topic:security", "topic:defi", "topic:layer2", "topic:onchain", "topic:derivatives", "topic:rwa", "topic:institutional", "topic:social"]) {
+    fail(errors, `growth taxonomy missing ${tag}`, growth.includes(`"${tag}"`));
+  }
+  fail(errors, "materialized news decisions must preserve growth authority", materialization.includes("growthAuthority: decision.growthAuthority"));
+  fail(errors, "AEO answers must be visible on both news detail surfaces", newsDetailFa.includes("growth.aeo.questions.map") && newsDetailEn.includes("growth.aeo.questions.map"));
+  fail(errors, "scheduled public intelligence must research SEO/GEO/AEO opportunities without auto-publish authority", aiAutomationStore.includes("SEO/GEO/AEO") && aiAutomationStore.includes("هیچ انتشار خودکار"));
+
+  fail(errors, "trend intelligence must expose 24h/7d/30d windows", trends.includes('"24h"') && trends.includes('"7d"') && trends.includes('"30d"'));
+  fail(errors, "trend ranking must include source diversity", trends.includes("sourceCount") && trends.includes("sources.size"));
+  fail(errors, "trend ranking must model verified social-source signals without raw-mention inflation", trends.includes("socialSignalCount") && trends.includes("sourceIsSocial"));
+  fail(errors, "trend widget must explain ranking transparency", trendWidget.includes("raw mention") && trendWidget.includes("source diversity"));
+  for (const page of [newsFa, newsEn, coinsFa, coinsEn, toolsFa, toolsEn]) {
+    fail(errors, "News/Coins/Tools surface missing shared trend widget", page.includes("GrowthTrendWidget"));
+  }
+
+  fail(errors, "C-level review must include a Growth Hacker AI role", intelligence.includes('"chief_growth_hacker_ai"'));
+  fail(errors, "Growth Hacker AI must remain recommendation-only", intelligence.includes("organic-growth:recommendation-only"));
+
+  fail(errors, "news growth archive migration missing immutable structured fields", migration.includes("growth_authority JSONB") && migration.includes("topic_tags TEXT[]") && migration.includes("translation_status"));
+  fail(errors, "news growth archive migration must be registered after the current registry tail", registry.includes('entry(83, "migration-step-083"'));
+
+  return errors;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const errors = evaluateMarketNewsGrowthEnterprise();
+  if (errors.length) {
+    console.error("Market/News/Growth enterprise authority failed:");
+    for (const error of errors) console.error(`- ${error}`);
+    process.exit(1);
+  }
+  console.log("Market/News/Growth enterprise authority passed.");
+}
