{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tecpey:mentor:speech-locale-profile:1",
  "title": "TecPey Mentor Speech Locale Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileVersion", "profileId", "rigContractVersion", "locale", "fallbackLocale", "phonemeAlphabet", "status", "silenceTarget", "mappings"],
  "properties": {
    "profileVersion": { "$ref": "#/$defs/semver" },
    "profileId": { "$ref": "#/$defs/profileId" },
    "rigContractVersion": { "const": "1.0.0" },
    "locale": { "$ref": "#/$defs/locale" },
    "fallbackLocale": { "anyOf": [{ "$ref": "#/$defs/locale" }, { "type": "null" }] },
    "phonemeAlphabet": { "const": "ipa" },
    "status": { "enum": ["draft", "candidate", "approved"] },
    "silenceTarget": { "const": "sil" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "profileId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "target": {
      "enum": ["sil", "bilabial", "labiodental", "interdental", "alveolar", "velar", "postalveolar", "sibilant", "nasal_lateral", "rhotic", "vowel_open", "vowel_mid_front", "vowel_close_front", "vowel_mid_back_round", "vowel_close_back_round"]
    },
    "controlValue": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jawOpen": { "$ref": "#/$defs/controlValue" },
        "lipClose": { "$ref": "#/$defs/controlValue" },
        "lipPress": { "$ref": "#/$defs/controlValue" },
        "lipWide": { "$ref": "#/$defs/controlValue" },
        "lipRound": { "$ref": "#/$defs/controlValue" },
        "lipFunnel": { "$ref": "#/$defs/controlValue" },
        "lowerLipBite": { "$ref": "#/$defs/controlValue" },
        "tongueTipUp": { "$ref": "#/$defs/controlValue" },
        "tongueForward": { "$ref": "#/$defs/controlValue" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phonemes", "target", "controls"],
      "properties": {
        "phonemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 16 }
        },
        "target": { "$ref": "#/$defs/target" },
        "controls": { "$ref": "#/$defs/controls" }
      }
    }
  }
}
