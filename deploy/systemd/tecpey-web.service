[Unit]
Description=TecPey Next.js Web App
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/tecpey
Environment=NODE_ENV=production
EnvironmentFile=/var/www/tecpey/.env.production
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20
SendSIGKILL=yes
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/tecpey/storage /var/www/tecpey/.next/cache

[Install]
WantedBy=multi-user.target
