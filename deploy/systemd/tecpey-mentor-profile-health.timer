[Unit]
Description=Continuously verify TecPey Mentor profile projection health
Documentation=https://github.com/tecpey/Tecpey-Os/blob/main/docs/operations/MENTOR_PROFILE_PROJECTION_RUNBOOK.md

[Timer]
OnActiveSec=1min
OnUnitActiveSec=1min
Persistent=true
RandomizedDelaySec=10
AccuracySec=5s
Unit=tecpey-mentor-profile-health.service

[Install]
WantedBy=timers.target
