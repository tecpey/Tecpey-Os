[Unit]
Description=TecPey Mentor Profile Independent Health Probe
Documentation=https://github.com/tecpey/Tecpey-Os/blob/main/docs/operations/MENTOR_PROFILE_PROJECTION_RUNBOOK.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=@@STATE_DIR@@
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=@@RUN_USER@@
Group=@@RUN_GROUP@@
WorkingDirectory=@@APP_DIR@@
EnvironmentFile=@@ENV_FILE@@
Environment=NODE_ENV=production
Environment=TECPEY_OPS_STATE_DIR=@@STATE_DIR@@
Environment=NPM_CONFIG_UPDATE_NOTIFIER=false
Environment=NPM_CONFIG_CACHE=/tmp/tecpey-npm-cache
ExecStart=@@NPM_BIN@@ run mentor:profiles:health
SuccessExitStatus=1
TimeoutStartSec=45s
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tecpey-mentor-profile-health
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadOnlyPaths=@@APP_DIR@@
ReadWritePaths=@@STATE_DIR@@
