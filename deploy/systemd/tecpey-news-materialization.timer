[Unit]
Description=Run TecPey Crypto News Materialization Hourly
Documentation=https://github.com/tecpey/Tecpey-Os/blob/main/docs/architecture/TECPEY_CONTENT_GROWTH_AUTOMATION_CONTRACT.md

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=60
AccuracySec=30s
Unit=tecpey-news-materialization.service

[Install]
WantedBy=timers.target
