[Unit]
Description=Drain TecPey Operational Alert and Signal Spools
Documentation=https://github.com/tecpey/Tecpey-Os/blob/main/docs/operations/COMMUNITY_CHALLENGE_SCHEDULER_RUNBOOK.md

[Timer]
OnBootSec=30s
OnUnitActiveSec=1min
RandomizedDelaySec=5s
FixedRandomDelay=true
AccuracySec=1s
Unit=tecpey-ops-alert-delivery.service

[Install]
WantedBy=timers.target
