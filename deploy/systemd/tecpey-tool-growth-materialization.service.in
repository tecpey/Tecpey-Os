[Unit]
Description=TecPey tool growth content materialization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@@RUN_USER@@
Group=@@RUN_GROUP@@
WorkingDirectory=@@APP_DIR@@
EnvironmentFile=@@ENV_FILE@@
Environment=NODE_ENV=production
ExecStart=@@NPM_BIN@@ run tools:growth:materialize
ExecStart=@@NPM_BIN@@ run tools:growth:check
SyslogIdentifier=tecpey-tool-growth-materialization

[Install]
WantedBy=multi-user.target
